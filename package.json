{
  "name": "chesspush",
  "private": true,
  "version": "0.2.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "test": "vitest run",
    "format": "prettier --write src tools/*.mjs tests/*.ts tests/*.mjs *.json *.ts *.html",
    "format:check": "prettier --check src tools/*.mjs tests/*.ts tests/*.mjs *.json *.ts *.html",
    "tauri": "tauri",
    "test:native": "npm run tauri build -- --debug --no-bundle && node tools/check-native.mjs",
    "benchmark": "node tests/benchmark.mjs && cargo run --manifest-path src-tauri/Cargo.toml --release --no-default-features --example scan -- .qa/benchmark.pgn.zst",
    "check:privacy": "node tools/check-privacy.mjs",
    "test:account-ui": "node tests/account-ui.mjs"
  },
  "dependencies": {
    "@lichess-org/chessground": "10.4.0",
    "@tauri-apps/api": "2.12.0",
    "@tauri-apps/plugin-dialog": "2.8.0",
    "chessops": "0.15.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tauri-apps/cli": "2.12.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
